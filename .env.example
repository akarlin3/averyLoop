# AveryLoop Environment Configuration
# Copy this file to .env and fill in the API keys for your preferred provider(s).

# LLM Provider Selection ("auto", "anthropic", "gemini", or "openai")
AVERYLOOP_PROVIDER=auto

# Provider API Keys (at least one required for live runs; none required for --dry-run)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# GitHub Personal Access Token (optional, for remote repository operations / PR workflows)
GITHUB_TOKEN=

# Optional: path to a custom project_config.yaml
# PROJECT_CONFIG=./project_config.yaml

# Optional: set to 1 to force plain-text output instead of the rich TUI dashboard
# AVERYLOOP_NO_TUI=0
